# Copy to .env and change the values.

# Postgres password (internal only, but use a long random value anyway).
# Use hex — the password is embedded in a URL, so characters like / + = @ break it:
#   openssl rand -hex 24
DB_PASSWORD=change-me-to-a-long-random-string

# Your domain pointing at the VPS, e.g. money.example.com
# Leave empty to serve plain HTTP on port 80 (first smoke test only).
DOMAIN=

# Timezone used for "today" and period boundaries.
TZ=Asia/Kolkata
